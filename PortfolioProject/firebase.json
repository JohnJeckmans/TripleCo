{
  "hosting": {
    "public": "dist/PortfolioProject/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.vcf",
        "headers": [{ "key": "Content-Type", "value": "text/vcard; charset=utf-8" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
